# BASIC_AUTH_USER=demo
# BASIC_AUTH_PASS=change-me

# Optional: extra origins allowed to talk to the *dev* server (comma-separated
# hostnames, e.g. your tunnel host or LAN IP) — Next 15 blocks cross-origin dev requests.
# ALLOWED_DEV_ORIGINS=192.168.1.20,my-tunnel.trycloudflare.com
